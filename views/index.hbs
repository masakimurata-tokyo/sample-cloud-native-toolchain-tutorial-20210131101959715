        <h3>API Documentation</h3>
        <p>Comprehensive API documentation with interactive examples</p>
      </div>
    </div>
  </div>
</div>

<!-- API Quick Access Section -->
<div class="api-section">
  <div class="container">
    <h2 class="section-title">Quick API Access</h2>
    <div class="api-grid">
      <div class="api-card">
        <div class="api-method">GET</div>
        <div class="api-content">
          <h4><a href="/hello?name=developer">/hello</a></h4>
          <p>Simple greeting endpoint with name parameter</p>
        </div>
      </div>
      
      <div class="api-card">
        <div class="api-method">GET</div>
        <div class="api-content">
          <h4><a href="/applications">/applications</a></h4>
          <p>Retrieve all applications in the system</p>
        </div>
      </div>
      
      <div class="api-card">
        <div class="api-method">GET</div>
        <div class="api-content">
          <h4><a href="/applications/1234">/applications/:id</a></h4>
          <p>Get specific application by ID</p>
        </div>
      </div>
    </div>
    
    <div class="api-cta">
      <a href="/docs" class="btn btn-outline">Browse Full API Documentation</a>
    </div>
  </div>
</div>

